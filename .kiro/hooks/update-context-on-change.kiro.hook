{
  "enabled": true,
  "name": "Auto-update context.md",
  "description": "When any significant source file is edited, remind the AI to update context.md with the latest changes so any new AI or developer can understand the project state.",
  "version": "1",
  "when": {
    "type": "fileEdited",
    "patterns": [
      "src/**/*.jsx",
      "src/**/*.js",
      "backend-java/src/**/*.java",
      "backend-java/src/main/resources/**/*.yml",
      "backend-java/src/main/resources/db/migration/*.sql"
    ]
  },
  "then": {
    "type": "askAgent",
    "prompt": "A project file was just edited. Review what changed and update the relevant section in context.md (f:\\frontend\\context.md) to reflect the change. Focus on: new routes, new features, API changes, DB schema changes, bug fixes, or config changes. Keep the \"LAST UPDATED\" section current with today's date and a brief description of what changed. Do NOT push context.md to git — it is in .gitignore."
  }
}