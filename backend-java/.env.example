# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=rupiksha
DB_USERNAME=postgres
DB_PASSWORD=your_password_here
DB_POOL_MAX=4
DB_POOL_MIN=1

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT Configuration
JWT_SECRET=change_this_to_a_long_random_secret_32_chars_min
JWT_ACCESS_MINUTES=480
JWT_REFRESH_DAYS=15

# OTP Configuration
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_PROVIDER=mock
OTP_BASE_URL=
OTP_API_KEY=
OTP_SENDER_ID=

# Payment Gateway Configuration
PAYMENT_PROVIDER=mock
PAYMENT_BASE_URL=
PAYMENT_KEY_ID=
PAYMENT_KEY_SECRET=
PAYMENT_WEBHOOK_SECRET=

# Recharge Provider Configuration
RECHARGE_PROVIDER=mock
RECHARGE_BASE_URL=
RECHARGE_API_KEY=
RECHARGE_API_SECRET=

# BBPS Provider Configuration
BBPS_PROVIDER=mock
BBPS_BASE_URL=
BBPS_API_KEY=
BBPS_API_SECRET=

# Service Toggles
SERVICE_AEPS_ENABLED=true
SERVICE_BBPS_ENABLED=true
SERVICE_TICKETS_ENABLED=true
SERVICE_RECHARGE_ENABLED=true
SERVICE_PAYOUT_ENABLED=true

# Levin AEPS Configuration
LEVIN_AEPS_BASE_URL=https://api.levinfintech.com/api/levin/v9
LEVIN_AEPS_API_TOKEN=your_levin_api_token
LEVIN_AEPS_USER_ID=your_levin_user_id
LEVIN_AEPS_ENCRYPTION_KEY=your_levin_encryption_key

# QuickZaps Payout Configuration
QUICKZAPS_BASE_URL=http://login.quickzaps.io
QUICKZAPS_API_KEY=f43a15b7-1048-4ce8-b1d1-5fcb70c80230
QUICKZAPS_PAYOUT_URL=https://login.quickzaps.io/api/PayoutApi/Payoutinitiate

# CORS Configuration
CORS_ALLOWED_ORIGINS=http://localhost:5173,https://rupiksha.in,https://www.rupiksha.in

# Public Base URL
PUBLIC_BASE_URL=http://localhost:8080

# Sentry Configuration (Optional)
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1

# Environment
SPRING_PROFILES_ACTIVE=dev
ALLOW_MOCK_PROVIDERS_IN_PRODUCTION=false
