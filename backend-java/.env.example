# =============================================================================
# Rupiksha backend-java environment variables
# Copy this file to backend-java/.env and fill in real values.
# For local dev, defaults in application.yml are fine (mock providers).
# For production, set SPRING_PROFILES_ACTIVE=prod and provide ALL values below.
# =============================================================================

# Active Spring profile. Use `prod` only in production - it enforces real
# provider configuration and a non-default JWT secret at startup.
SPRING_PROFILES_ACTIVE=dev

PORT=8080

# -----------------------------------------------------------------------------
# Postgres (required)
# -----------------------------------------------------------------------------
DB_URL=jdbc:postgresql://localhost:5432/rupiksha
DB_USERNAME=postgres
DB_PASSWORD=postgres

# -----------------------------------------------------------------------------
# Redis (required for OTP reference storage)
# -----------------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# -----------------------------------------------------------------------------
# JWT (required)
# In prod profile, JWT_SECRET must be >=32 chars and NOT equal the placeholder.
# Generate one with: openssl rand -base64 48
# -----------------------------------------------------------------------------
JWT_SECRET=change_this_to_a_long_random_secret_32_chars_min
JWT_ACCESS_MINUTES=30
JWT_REFRESH_DAYS=15

# -----------------------------------------------------------------------------
# CORS + public URLs (required)
# In prod, CORS_ALLOWED_ORIGINS must NOT contain localhost.
# -----------------------------------------------------------------------------
CORS_ALLOWED_ORIGINS=http://localhost:5173
PUBLIC_BASE_URL=http://localhost:8080

# -----------------------------------------------------------------------------
# Provider selection (for local dev use "mock"; for prod use real names)
# -----------------------------------------------------------------------------
OTP_PROVIDER=mock
# OTP_PROVIDER=2factor
OTP_BASE_URL=
OTP_API_KEY=
OTP_SENDER_ID=RUPIKS

PAYMENT_PROVIDER=mock
# PAYMENT_PROVIDER=razorpay
PAYMENT_BASE_URL=
PAYMENT_KEY_ID=
PAYMENT_KEY_SECRET=
PAYMENT_WEBHOOK_SECRET=

RECHARGE_PROVIDER=mock
# RECHARGE_PROVIDER=paysprint
RECHARGE_BASE_URL=
RECHARGE_API_KEY=
RECHARGE_API_SECRET=

AEPS_PROVIDER=mock
# AEPS_PROVIDER=custom
AEPS_BASE_URL=
AEPS_API_KEY=
AEPS_API_SECRET=

BBPS_PROVIDER=mock
# BBPS_PROVIDER=custom
BBPS_BASE_URL=
BBPS_API_KEY=
BBPS_API_SECRET=

# -----------------------------------------------------------------------------
# Service feature toggles (default true)
# -----------------------------------------------------------------------------
SERVICE_AEPS_ENABLED=true
SERVICE_BBPS_ENABLED=true
SERVICE_TICKETS_ENABLED=true
SERVICE_RECHARGE_ENABLED=true
SERVICE_PAYOUT_ENABLED=true

# Emergency escape hatch to allow mock providers in production.
# LEAVE AS false for real deployments.
ALLOW_MOCK_PROVIDERS_IN_PRODUCTION=false

# -----------------------------------------------------------------------------
# Observability (optional)
# -----------------------------------------------------------------------------
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1

# -----------------------------------------------------------------------------
# OTP behavior (optional)
# -----------------------------------------------------------------------------
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
